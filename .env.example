# Copier ce fichier en .env et remplir les valeurs.
# Ne JAMAIS versionner le fichier .env.

# Base de données PostgreSQL
DATABASE_URL="postgresql://orkestra:orkestra@localhost:5432/orkestra?schema=public"

# Base dédiée aux tests d'intégration (jamais la base de développement).
# Si elle est vide, les tests d'intégration sont ignorés.
TEST_DATABASE_URL=""

# ─── Authentification (Better Auth) ─────────────────────────────────────────
# Secret de 32 caractères minimum. Générer avec :
#   PowerShell : [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#   macOS/Linux : openssl rand -base64 32
# Obligatoire en production. En développement, un secret temporaire est utilisé s'il est vide.
BETTER_AUTH_SECRET=""
# Adresse publique de l'application (sans / final)
BETTER_AUTH_URL="http://localhost:3000"

# Google (OAuth 2.0 / OpenID Connect) — laisser vide pour désactiver
# URI de redirection à déclarer : {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID — laisser vide pour désactiver
# URI de redirection à déclarer : {BETTER_AUTH_URL}/api/auth/callback/microsoft
# MICROSOFT_TENANT_ID : "common" (tous comptes), "organizations" (comptes pro) ou l'ID d'un tenant
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="organizations"

# OpenAI — laisser vide tant que les dépenses API ne sont pas autorisées
OPENAI_API_KEY=""

# Stripe (abonnements)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# n8n (intégrations)
N8N_BASE_URL=""
N8N_API_KEY=""

# Mode démonstration : true = intégrations simulées, aucun appel externe
ORKESTRA_DEMO_MODE="true"
